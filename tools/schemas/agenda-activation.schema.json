{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agenda activation record",
  "description": "Which single proposal each party authorized as its active one, under a threshold fixed BEFORE collection. Records what every sampled invocation named -- a fact about the samples -- and never that a party prefers anything.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_type", "cohort", "authorization_rule",
               "what_this_does_not_claim", "enforced_in_load_queue", "sources", "by_party"],
  "properties": {
    "schema_version": {"const": "oagrc-agenda-activation-0.1"},
    "artifact_type": {"const": "agenda_activation_record"},
    "cohort": {"type": "string"},
    "authorization_rule": {"type": "string"},
    "what_this_does_not_claim": {"type": "string"},
    "enforced_in_load_queue": {
      "description": "Whether load_queue() actually applies this. Capture and enforcement are separate acts; a record that claimed enforcement it did not have is the defect class this field exists to prevent (D-42).",
      "type": "boolean"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {"path": {"type": "string"},
                               "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "by_party": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["party", "k_required", "k_collected", "samples", "distribution",
                     "active_proposal_id", "selection_outcome", "category"],
        "properties": {
          "party": {"type": "string"},
          "k_required": {"type": "integer", "minimum": 1},
          "k_collected": {"type": "integer", "minimum": 0},
          "samples": {"type": "array"},
          "distribution": {"type": "object"},
          "active_proposal_id": {"type": ["string", "null"]},
          "selection_outcome": {"enum": ["authorized", "none_authorized", "indeterminate"]},
          "category": {"enum": ["unanimous", "explicit_none", "sample_disagreement",
                                "invalid", "missing"]}
        }
      }
    }
  }
}
