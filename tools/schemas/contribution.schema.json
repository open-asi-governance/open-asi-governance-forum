{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-asi-governance/open-asi-governance-forum/tools/schemas/contribution.schema.json",
  "title": "OAGRC contribution provenance record",
  "description": "Provenance for one captured model or human contribution. Written at capture time, never reconstructed. The raw response it references is canonical and immutable.",
  "type": "object",
  "required": [
    "schema_version", "artifact_id", "artifact_type", "round", "raw", "prompt",
    "contributor", "captured_utc", "phase", "edit_status", "k", "attribution_status", "captured_by"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "oagrc-contribution-0.1" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "const": "contribution" },
    "round": { "type": "string", "minLength": 1 },
    "raw": { "$ref": "#/$defs/anchoredFile" },
    "prompt": { "$ref": "#/$defs/anchoredFile" },
    "contributor": { "$ref": "#/$defs/contributor" },
    "captured_utc": {
      "type": "string",
      "description": "Time of capture, recorded AT capture. Never reconstructed after the fact.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "capture_method": { "type": "string" },
    "phase": { "type": "string", "enum": ["Phase-1 (blind)", "Phase-2 (informed)"] },
    "edit_status": {
      "type": "string",
      "description": "'unedited' or a description of the edit and who made it. Never blank.",
      "minLength": 1
    },
    "k": {
      "type": "integer",
      "minimum": 1,
      "description": "Total independent samples collected for this prompt from this contributor."
    },
    "sample_index": { "type": "integer", "minimum": 1 },
    "variance_reported": { "type": "boolean" },
    "variance": { "type": ["string", "null"] },
    "citability": {
      "type": "string",
      "enum": ["citable", "non-citable (k=1)", "non-citable (variance unreported)"]
    },
    "attribution_status": {
      "type": "string",
      "enum": ["active", "superseded", "withdrawn", "repudiated", "invocation integrity disputed"]
    },
    "captured_by": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "description": "k=1 can never be citable as evidence of a model's position.",
      "if": { "properties": { "k": { "const": 1 } }, "required": ["k"] },
      "then": { "properties": { "citability": { "const": "non-citable (k=1)" } } }
    },
    {
      "description": "Citable requires k>=5 AND a reported variance.",
      "if": { "properties": { "citability": { "const": "citable" } }, "required": ["citability"] },
      "then": {
        "properties": {
          "k": { "minimum": 5 },
          "variance_reported": { "const": true }
        },
        "required": ["variance_reported"]
      }
    }
  ],
  "$defs": {
    "anchoredFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "contributor": {
      "type": "object",
      "required": ["identity", "provider"],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "A distinct model or invocation surface. 'Claude Opus 5' and 'Claude Code' are different identities and are never merged."
        },
        "provider": { "type": "string", "minLength": 1 },
        "version_identifier": { "type": ["string", "null"] },
        "version_unknown_reason": { "type": "string", "minLength": 1 },
        "sampling_parameters": { "type": ["object", "null"] },
        "sampling_unknown_reason": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": ["string", "null"] },
        "reasoning_effort_unknown_reason": { "type": "string", "minLength": 1 },
        "system_instructions": { "type": ["string", "null"] },
        "system_instructions_unknown_reason": { "type": "string", "minLength": 1 },
        "tools_used": { "type": "array", "items": { "type": "string" } },
        "prior_context": { "type": ["string", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "version_identifier": { "type": "null" } }, "required": ["version_identifier"] }, "then": { "required": ["version_unknown_reason"] } },
        { "if": { "properties": { "sampling_parameters": { "type": "null" } }, "required": ["sampling_parameters"] }, "then": { "required": ["sampling_unknown_reason"] } },
        { "if": { "properties": { "reasoning_effort": { "type": "null" } }, "required": ["reasoning_effort"] }, "then": { "required": ["reasoning_effort_unknown_reason"] } },
        { "if": { "properties": { "system_instructions": { "type": "null" } }, "required": ["system_instructions"] }, "then": { "required": ["system_instructions_unknown_reason"] } }
      ]
    }
  }
}
